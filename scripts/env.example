# farsoudi.com journal client secrets
#
# copy to scripts/.env (gitignored) and `chmod 600`.
#
# names are arbitrary; reference them from config.yaml as ${VAR}
# (or ${VAR:-default}). the real environment takes precedence over this file.

LOCAL_DB_USER=changeme
LOCAL_DB_PASS=changeme

REMOTE_DB_USER=changeme
REMOTE_DB_PASS=changeme
