up() {
  if [ "$1" = "--prod" ]; then
    echo "starting (prod)"
    docker compose --profile prod up --build -d
  else
    echo "starting (dev, hot reload)"
    docker compose --profile dev up --build -d
  fi
}
reup() {
  down
  up "$1"
}
down() {
  # --profile dev --profile prod -> all services visible to compose,
  # so it can tear down the shared network regardless of which mode is running
  docker compose --profile dev --profile prod down --remove-orphans
}