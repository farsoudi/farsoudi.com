<div class="h-300 border-l-2 border-r-2 p-20 bg-white relative overflow-hidden" data-sliver-delta="0.001" data-sliver-base="0.1" data-sliver-t="2" data-sliver-images='<%- JSON.stringify(images) %>'>
  <% for (let i = 0; i < 3; i++) { const img = images[i % images.length]; %>
    <img src="/img/<%= img %>" class="absolute inset-0 w-full h-full object-cover sliver-img" style="opacity: <%= i === 0 ? 1 : 0.45 %>;" loading="<%= i === 0 ? 'eager' : 'lazy' %>" decoding="async" <%= i === 0 ? 'fetchpriority="high"' : '' %> />
  <% } %>
</div>

