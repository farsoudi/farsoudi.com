<%- include('partials/header.ejs') %>
<div class="border-2 border-b-0 p-10">
  <div class="flex flex-row justify-between items-baseline gap-4">
    <h1 class="font-bold"><%= entry.title %></h1>
    <h1><%= entry.day %></h1>
  </div>
  <br>
  <div class="whitespace-pre-wrap"><%= entry.body %></div>
  <% if (entry.tagList.length) { %>
  <br>
  <div class="flex flex-row flex-wrap gap-2">
    <% entry.tagList.forEach(function (t) { %>
      <a href="/journal?tags=<%= encodeURIComponent(t) %>#controls" class="whitespace-nowrap px-2 py-1 text-sm sm:text-base outline outline-2 outline-black"><%= t %></a>
    <% }); %>
  </div>
  <% } %>
  <br>
  <a href="/journal" class="underline">&larr; back</a>
</div>
<%- include('partials/footer.ejs') %>
