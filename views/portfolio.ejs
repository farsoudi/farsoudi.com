<%- include('partials/header.ejs') %>

<div class="border-t-2"></div>

<div class="lg:mx-auto lg:max-w-[1400px]">

  <%
    const regions = [
      { key: 'projects', label: 'projects' },
      { key: 'professional', label: 'professional' },
      { key: 'hackathon', label: 'hackathons' },
    ];
  %>

  <div class="px-10 sm:px-20 pt-14 pb-8">
    <p class="text-2xl">portfolio</p>
    <br/>
    <p>selected work — projects, professional experience, and hackathons.</p>
  </div>

  <% regions.forEach(function (region) { %>
    <% const items = projects.filter(function (p) { return p.region === region.key; }); %>
    <% if (items.length) { %>
      <% if (region.key !== 'projects') { %>
        <div class="px-10 sm:px-20 pt-14 pb-8">
          <p class="text-2xl"><%= region.label %></p>
        </div>
      <% } %>
      <div class="px-10 sm:px-20 pb-14">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
          <% items.forEach(function (p) { %>
            <a href="/portfolio/<%= p.slug %>" class="group border-2 flex flex-col hover:bg-black hover:text-white active:bg-black active:text-white focus:bg-black focus:text-white transition-colors">
              <div class="aspect-[4/3] overflow-hidden border-b-2 bg-white">
                <% if (p.media.hero) { %>
                  <img src="<%= p.media.hero %>" alt="<%= p.title %>" loading="lazy" decoding="async" class="w-full h-full <%= p.media.contain ? 'object-contain p-6' : 'object-cover' %>" />
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center p-5">
                    <span class="text-2xl font-bold text-center leading-tight"><%= p.title %></span>
                  </div>
                <% } %>
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex flex-row justify-between items-baseline gap-3">
                  <h2 class="text-xl font-bold"><%= p.title %></h2>
                  <span class="text-sm whitespace-nowrap"><%= p.date %></span>
                </div>
                <p class="mt-1"><%= p.subtitle %></p>
                <p class="mt-3 text-sm"><%= p.summary %></p>
                <div class="mt-4 pt-4 border-t-2 flex flex-wrap gap-2 group-hover:border-white">
                  <% p.tech.slice(0, 5).forEach(function (t) { %>
                    <span class="text-xs px-2 py-1 outline outline-1 outline-black group-hover:outline-white whitespace-nowrap"><%= t %></span>
                  <% }); %>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>
  <% }); %>

</div>

<%- include('partials/footer.ejs') %>
